---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('entries', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const images = [
  ...(data.cover ? [data.cover] : []),
  ...(data.gallery ?? []),
];

const published = (await getCollection('entries', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const i = published.findIndex((e) => e.id === entry.id);
const prev = i > 0 ? published[i - 1] : null;
const next = i < published.length - 1 ? published[i + 1] : null;
---
<Base title={`${data.name.en} — Tokyo French Illustrated`} description={data.caption.en}>
  <main class="page">

    <div class="back-row">
      <a class="ulink serif-i" href="/" data-i18n="entry.back">← Back to Contents</a>
    </div>

    <header class="e-hero">
      <div class="e-meta caps mute">
        <span data-i18n="entry.visited">Visited</span>
        <span class="sep">—</span>
        <span>{data.date.toISOString().slice(0, 10)}</span>
        {data.neighborhood && (
          <>
            <span class="sep-big">·</span>
            <span data-i18n="entry.neighborhood">Neighborhood</span>
            <span class="sep">—</span>
            <span>{data.neighborhood}</span>
          </>
        )}
      </div>

      <h1 class="e-name serif-i">
        <span data-i18n-zh={data.name.zh} data-i18n-ja={data.name.ja} data-i18n-en={data.name.en}>{data.name.en}</span>
      </h1>

      <p class="e-caption serif">
        <span data-i18n-zh={data.caption.zh} data-i18n-ja={data.caption.ja} data-i18n-en={data.caption.en}>{data.caption.en}</span>
      </p>
    </header>

    <article class="e-body reveal">
      <Content />
    </article>

    {images.length > 0 && (
      <section class="e-gallery">
        {images.map((img, i) => (
          <figure class="e-fig reveal" style={`--i:${i}`}>
            <Image src={img} alt={`${data.name.en} — fig. ${i + 1}`} widths={[500, 800, 1100]} sizes="(max-width: 820px) 100vw, 45vw" />
            <figcaption class="caps mute">Fig. {String(i + 1).padStart(2, '0')}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <nav class="e-pager">
      <div class="pg-cell">
        {prev ? (
          <a class="ulink" href={`/${prev.id}`}>
            <span class="caps mute pg-k">← Previous</span>
            <span class="pg-v serif-i">
              <span data-i18n-zh={prev.data.name.zh} data-i18n-ja={prev.data.name.ja} data-i18n-en={prev.data.name.en}>{prev.data.name.en}</span>
            </span>
          </a>
        ) : <span class="caps dim">—</span>}
      </div>
      <div class="pg-cell pg-next">
        {next ? (
          <a class="ulink" href={`/${next.id}`}>
            <span class="caps mute pg-k">Next →</span>
            <span class="pg-v serif-i">
              <span data-i18n-zh={next.data.name.zh} data-i18n-ja={next.data.name.ja} data-i18n-en={next.data.name.en}>{next.data.name.en}</span>
            </span>
          </a>
        ) : <span class="caps dim">—</span>}
      </div>
    </nav>

  </main>

  <style>
    .page { padding-top: clamp(24px, 4vw, 40px); padding-bottom: clamp(60px, 8vw, 96px); }

    .back-row { padding: 0 0 clamp(20px, 3vw, 32px); }

    .e-hero {
      display: flex; flex-direction: column; gap: 18px;
      padding: clamp(20px, 3vw, 36px) 0 clamp(36px, 5vw, 56px);
      border-bottom: var(--rule);
    }
    .e-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .e-meta .sep { color: var(--dim); padding: 0 2px; }
    .e-meta .sep-big { color: var(--dim); padding: 0 10px; }

    .e-name {
      font-family: var(--f-serif);
      font-style: italic;
      font-weight: 500;
      font-size: clamp(56px, 9vw, 136px);
      line-height: 0.94;
      letter-spacing: -0.025em;
      margin: 0;
    }
    .e-caption {
      font-family: var(--f-serif);
      font-size: clamp(20px, 1.7vw, 26px);
      line-height: 1.4;
      color: var(--ink);
      max-width: 60ch;
      margin: 0;
    }

    .e-body {
      max-width: 68ch;
      margin: clamp(40px, 6vw, 72px) auto;
      font-family: var(--f-serif);
      font-size: clamp(17px, 1.2vw, 19px);
      line-height: 1.75;
      color: var(--ink);
    }
    .e-body :global(p) { margin: 0 0 1em; }
    .e-body :global(p + p) { text-indent: 2em; margin-top: 0; }
    .e-body :global(blockquote) {
      margin: 1.5em 0;
      padding-left: 20px;
      border-left: 2px solid var(--ink);
      font-style: italic;
      color: var(--mute);
    }
    .e-body :global(em) { font-style: italic; }

    .e-gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(24px, 3vw, 40px);
      padding: clamp(40px, 6vw, 72px) 0;
      max-width: 1080px;
      margin: 0 auto;
    }
    .e-fig { margin: 0; }
    .e-fig :global(img) { width: 100%; height: auto; display: block; }
    .e-fig figcaption { padding-top: 10px; }

    .e-pager {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      padding: clamp(40px, 6vw, 72px) 0 0;
      border-top: var(--rule);
    }
    .pg-cell a { display: flex; flex-direction: column; gap: 6px; }
    .pg-next { justify-self: end; text-align: right; }
    .pg-v { font-size: clamp(22px, 2vw, 28px); line-height: 1.2; letter-spacing: -0.01em; }

    @media (max-width: 820px) {
      .e-gallery { grid-template-columns: 1fr; }
      .e-pager { grid-template-columns: 1fr; gap: 24px; }
      .pg-next { justify-self: start; text-align: left; }
    }
  </style>
</Base>
