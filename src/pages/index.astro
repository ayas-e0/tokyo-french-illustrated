---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const all = (await getCollection('entries', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <main class="page">

    <!-- ═════════════════════════════════════ INTRO -->
    <section class="intro">
      <div class="intro-kicker caps mute">
        <span data-i18n="mh.vol">VOL. 01</span>
        <span class="sep">·</span>
        <span data-i18n="mh.season">Spring MMXXVI · Ongoing</span>
      </div>

      <h1 class="intro-title serif-i" data-i18n="intro.title">Tokyo French Illustrated</h1>
      <p class="intro-sub caps" data-i18n="intro.sub">東京フレンチ図鑑 · 东京法餐图鉴</p>

      <p class="intro-body serif" data-i18n="intro.body">
        A personal illustrated almanac of French and Japanese-French bistros in Tokyo. No ratings. No recommendations. Only the rooms I sat in, the words I wrote, the frames I kept. Ongoing.
      </p>
    </section>

    <hr class="rule" />

    <!-- ═════════════════════════════════════ INDEX -->
    <section class="idx">
      <header class="idx-head">
        <h2 class="idx-h serif-i" data-i18n="idx.heading">Contents</h2>
        <span class="caps mute">
          {String(all.length).padStart(2, '0')} <span data-i18n="idx.count_prefix">entries</span>
        </span>
      </header>

      {all.length === 0 ? (
        <div class="idx-empty reveal">
          <p class="serif-i" data-i18n="idx.empty">An archive in preparation.</p>
        </div>
      ) : (
        <ol class="idx-list">
          {all.map((e, i) => (
            <li class="idx-row reveal" style={`--i:${i}`}>
              <a class="idx-link" href={`/${e.id}`}>
                <span class="r-num serif-i">{String(all.length - i).padStart(2, '0')}</span>

                <div class="r-main">
                  <div class="r-meta caps mute">
                    <span>{e.data.date.toISOString().slice(0, 10)}</span>
                    {e.data.neighborhood && <><span class="dot">·</span><span>{e.data.neighborhood}</span></>}
                  </div>
                  <h3 class="r-title serif-i">
                    <span data-i18n-zh={e.data.name.zh} data-i18n-ja={e.data.name.ja} data-i18n-en={e.data.name.en}>{e.data.name.en}</span>
                  </h3>
                  <p class="r-cap serif" data-i18n-zh={e.data.caption.zh} data-i18n-ja={e.data.caption.ja} data-i18n-en={e.data.caption.en}>
                    {e.data.caption.en}
                  </p>
                </div>

                {e.data.cover && (
                  <div class="r-thumb">
                    <Image src={e.data.cover} alt="" widths={[120, 240]} sizes="90px" />
                  </div>
                )}

                <span class="r-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </section>

    <hr class="rule" />

    <!-- ═════════════════════════════════════ COLOPHON -->
    <footer class="col">
      <span class="caps mute" data-i18n="foot.colophon">
        © Ayase · MMXXVI · Set in Zodiak &amp; Switzer · Built with Astro
      </span>
      <a class="caps mute ulink" href="https://github.com/ayas-e0/tokyo-french-illustrated" target="_blank" rel="noopener" data-i18n="foot.opensource">
        Open source · PRs welcome · GitHub
      </a>
    </footer>

  </main>

  <style>
    .page { padding-top: clamp(60px, 8vw, 96px); padding-bottom: clamp(60px, 6vw, 80px); }

    .intro {
      display: flex; flex-direction: column; gap: 18px;
      padding-bottom: clamp(56px, 8vw, 96px);
    }
    .intro-kicker { display: flex; gap: 10px; align-items: center; }
    .intro-kicker .sep { color: var(--dim); }

    .intro-title {
      font-family: var(--f-serif);
      font-style: italic;
      font-weight: 500;
      font-size: clamp(54px, 8.5vw, 128px);
      line-height: 0.95;
      letter-spacing: -0.025em;
      margin: 8px 0 0;
    }
    .intro-sub {
      color: var(--mute);
      font-size: 12px;
      letter-spacing: 0.18em;
      margin: 4px 0 12px;
    }
    .intro-body {
      font-family: var(--f-serif);
      font-size: clamp(18px, 1.5vw, 22px);
      line-height: 1.5;
      max-width: 52ch;
      color: var(--ink);
      margin: 0;
    }

    .idx { padding: clamp(40px, 5vw, 64px) 0 clamp(48px, 6vw, 72px); }
    .idx-head {
      display: flex; justify-content: space-between; align-items: baseline;
      padding-bottom: 24px;
      border-bottom: var(--rule);
    }
    .idx-h {
      font-family: var(--f-serif);
      font-style: italic;
      font-size: clamp(32px, 3.5vw, 48px);
      letter-spacing: -0.015em;
      margin: 0;
    }

    .idx-empty { padding: clamp(64px, 10vw, 120px) 0; text-align: center; }
    .idx-empty p {
      font-size: clamp(24px, 2.6vw, 36px);
      color: var(--mute);
      margin: 0;
    }

    .idx-list { list-style: none; padding: 0; margin: 0; }
    .idx-row { border-bottom: var(--rule-soft); }
    .idx-link {
      display: grid;
      grid-template-columns: 68px 1fr 90px 28px;
      gap: clamp(16px, 2.5vw, 32px);
      align-items: center;
      padding: clamp(20px, 3vw, 28px) 0;
      color: var(--ink);
    }
    .r-num {
      font-family: var(--f-serif);
      font-style: italic;
      font-size: clamp(28px, 3vw, 40px);
      color: var(--mute);
      line-height: 1;
    }
    .r-main { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .r-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .r-meta .dot { color: var(--dim); }
    .r-title {
      font-family: var(--f-serif);
      font-style: italic;
      font-weight: 500;
      font-size: clamp(22px, 2.2vw, 32px);
      line-height: 1.2;
      letter-spacing: -0.015em;
      margin: 0;
    }
    .r-cap {
      font-family: var(--f-serif);
      font-size: 14px;
      line-height: 1.5;
      color: var(--mute);
      margin: 0;
    }
    .r-thumb {
      width: 90px;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      justify-self: end;
    }
    .r-thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .r-arrow {
      color: var(--dim);
      font-family: var(--f-serif);
      font-style: italic;
      font-size: 20px;
      transition: transform 280ms ease, color 280ms ease;
      justify-self: end;
    }
    .idx-link:hover .r-arrow { color: var(--ink); transform: translateX(4px); }
    .idx-link:hover .r-title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

    .col {
      display: flex; justify-content: space-between; gap: 20px;
      padding: 24px 0 8px;
      flex-wrap: wrap;
    }

    @media (max-width: 820px) {
      .idx-link { grid-template-columns: 40px 1fr 72px 18px; gap: 12px; }
      .r-num { font-size: 22px; }
      .r-thumb { width: 72px; }
      .r-title { font-size: 20px; }
    }
  </style>
</Base>
